  "license": "MIT",
  "categories": [
    "security",
    "devops",
    "compliance",
    "infrastructure"
  ],
  "tags": [
    "terraform",
    "kubernetes",
    "docker",
    "aws",
    "iac",
    "security",
    "compliance",
    "cis",
    "nist",
    "pci-dss",
    "hipaa",
    "soc2",
    "gdpr",
    "devsecops",
    "cloudformation",
    "ansible",
    "github-actions"
  ],
  "contents": {
    "skills": ["skills/iac-security-review"],
    "commands": [
      "commands/iac-security-review.md",
      "commands/compliance-check.md",
      "commands/generate-report.md",
      "commands/fix-finding.md",
      "commands/secret-scan.md"
    ],
    "agents": [
      "agents/security-reviewer.md",
      "agents/compliance-mapper.md",
      "agents/report-generator.md"
    ],
    "rules": [
      "rules/security-first.md",
      "rules/iac-standards.md"
    ],
    "hooks": "hooks/hooks.json"
  },
  "install": {
    "claude_code": "/plugin install uttej-badwane/secure-cloud-prompt-engineering",
    "manual": "curl -fsSL https://raw.githubusercontent.com/uttej-badwane/secure-cloud-prompt-engineering/main/install.sh | bash"
  },
  "changelog_url": "https://github.com/uttej-badwane/secure-cloud-prompt-engineering/releases"
