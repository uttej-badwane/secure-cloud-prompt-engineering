{
  "name": "secure-cloud-prompt-engineering",
  "display_name": "IaC Security Review for Claude Code",
  "description": "Security-focused Claude Code skill and slash commands for Infrastructure as Code review. Identifies misconfigurations, enforces least privilege, and maps findings to CIS, NIST 800-53, NIST 800-171, PCI-DSS, SOC 2, HIPAA, GDPR, and ISO 27001 compliance controls. Covers Terraform, Kubernetes, Docker, CloudFormation, Ansible, Helm, GitHub Actions, and GitLab CI.",
  "version": "1.1.0",
  "author": {
    "name": "Uttej Badwane",
    "github": "uttej-badwane"
  },
